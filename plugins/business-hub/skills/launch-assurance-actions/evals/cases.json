{
  "skill_name": "launch-assurance-actions",
  "version": "0.2.0",
  "status": "designed_not_executed",
  "instructions": "合成fixture仅作离线行为验收。让待测Agent仅获得prompt、skill和fixture，记录查询/动作轨迹与答案，再按assertions评审；不能作为线上实测通过报告。执行类用例禁止写生产。",
  "evals": [
