      "assertions": [
        "区分原始300000、最终240000和基准260000",
        "周预测应核对已确认最终目标，不能声称已执行重算"
      ]
    },
    {
      "id": "target-invalid",
      "prompt": "计算调整后的目标差额",
      "fixture": {
        "target_first_month_sales_qty": 300000,
        "final_target_sales_qty": "待确认"
      },
      "assertions": [
        "不将待确认转0，不强行给数值差额"
      ]
    },
    {
      "id": "weeks",
      "prompt": "四周为什么有八条需求？",
      "fixture": {
        "weeks": 4,
        "warehouses": 2,
        "rows": 8
      },
      "assertions": [
        "解释四周期可按仓拆为八条，不判重复或少算"
      ]
    },
