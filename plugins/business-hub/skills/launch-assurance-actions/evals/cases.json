        "plans": [
          {
            "plan_id": "NP009",
            "dish_id": "D1"
          },
          {
            "plan_id": "NP010",
            "dish_id": "D1"
          }
        ],
        "forecasts": [
          {
            "plan_id": "NP009",
            "demand_nr": "F9"
          },
          {
            "plan_id": "NP010",
            "demand_nr": "F10"
          }
        ]
      },
      "assertions": [
        "按plan_id锁定NP009，再沿dish_demand_nr追溯",
        "不得仅按D1混入NP010数据"
      ]
